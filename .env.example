# copy to .env and adjust, then: docker compose up -d --build

# host port published by the web container
WEB_PORT=80

# Django/DRF origin behind the /api and /media proxies (no trailing slash).
# host.docker.internal reaches a backend running on the host itself.
API_UPSTREAM=http://host.docker.internal:8000

# optional free CoinGecko demo key; without it /cg uses the keyless quota,
# which is easily exhausted by normal traffic
COINGECKO_API_KEY=

# baked into the bundle at build time (docker compose build after changing)
VITE_API_BASE=
VITE_API_SALT=KXXADFDFDF
