# Rendered by the nginx entrypoint (envsubst) into /etc/nginx/conf.d at start.
# Only API_UPSTREAM is substituted; every other $variable is left to nginx.

# third-party feeds resolve per request, so a DNS hiccup at boot cannot keep
# nginx from starting; 127.0.0.11 is Docker's embedded resolver
resolver 127.0.0.11 1.1.1.1 valid=300s ipv6=off;
resolver_timeout 5s;

# API_UPSTREAM is a full URL; split the host out so proxy_pass can take a
# variable (the resolver above is IPv4-only, and Docker networks have no IPv6)
map $api_target $api_host {
    ~^[a-z]+://([^/]+) $1;
}

# $app_route decides whether a path may fall back to the SPA shell. The map
# lives in app-routes.conf, generated from src/screen-map.js during the build,
# so the allowlist cannot drift from the router. Anything else — dotfiles,
# scanner probes (/.env, /.git, /wp-admin, *.php) or unknown paths — gets a
# plain 404 instead of a 200 HTML page.
include /etc/nginx/snippets/app-routes.conf;

# COOP only makes sense on a trustworthy origin. On plain http the browser
# ignores it and logs a console error, so it is sent over https only.
map $scheme $coop_policy {
    default "";
    https "same-origin";
}

# public feeds are cached briefly: CoinGecko rate-limits by IP, so repeated
# page loads would otherwise surface as 429s in the browser
proxy_cache_path /var/cache/nginx/feeds levels=1:2 keys_zone=feeds:10m max_size=200m inactive=24h use_temp_path=off;

server {
    listen 80 default_server;
    server_name _;

    # resolved per request: DNS changes and a backend restart do not require
    # recreating the container
    set $api_target "${API_UPSTREAM}";
    # optional free CoinGecko demo key; empty means the keyless quota applies
    set $cg_api_key "${COINGECKO_API_KEY}";

    root /usr/share/nginx/html;
    index index.html;

    # never advertise the nginx version
    server_tokens off;
    charset utf-8;

    # profile photos and review images arrive as multipart bodies
    client_max_body_size 12m;

    include /etc/nginx/snippets/security-headers.conf;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/css application/javascript application/json application/xml image/svg+xml text/plain;

    # ---- health probe (docker compose / load balancers) -------------------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---- static bundle ----------------------------------------------------
    # The assets are served from the retention volume: the entrypoint script
    # merges every build into it and prunes only files older than the window,
    # so a chunk from the previous deploy is still here when an open tab asks
    # for it. Vite fingerprints the js/css chunks, so those are safe to pin.
    location ~ "^/assets/.+-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        root /srv;
        try_files $uri =404;
    }

    # Deep links such as /ref/CODE are answered by the shell at that path. A
    # shell that still carries relative refs (an older build, or one an edge
    # cached) then asks for /ref/assets/<chunk>: map the prefix back to the real
    # file so the page boots instead of 404ing every chunk it needs.
    location ~ "^/.+/assets/" {
        rewrite ^/.+/assets/(.*)$ /assets/$1 last;
    }

    # everything copied verbatim from public/ (the avatars and illustrations)
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=604800";
        access_log off;
        root /srv;
        try_files $uri =404;
    }

    # served through error_page for missing thumbnails; never cache it, so an
    # uploaded image replaces the placeholder on the very next visit
    location = /assets/img/news-placeholder.svg {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store, must-revalidate";
        access_log off;
        try_files $uri =404;
    }

    # a stale shell would keep pointing at the previous bundle: revalidate it
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store, must-revalidate";
    }

    # ---- Django/DRF — the prefixes the dev server used to proxy -----------
    location /api/ {
        proxy_pass $api_target;
        include /etc/nginx/snippets/api-proxy.conf;

        # the support chat keeps an SSE stream open
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # news thumbnails are uploaded content: when a file is missing upstream,
    # answer with the local placeholder instead of a broken image
    location /media/news/ {
        proxy_pass $api_target;
        include /etc/nginx/snippets/api-proxy.conf;
        proxy_read_timeout 60s;
        proxy_intercept_errors on;
        error_page 404 =200 /assets/img/news-placeholder.svg;
    }

    location /media/ {
        proxy_pass $api_target;
        include /etc/nginx/snippets/api-proxy.conf;
        proxy_read_timeout 60s;
    }

    # ---- third-party feeds ------------------------------------------------
    # Fear & Greed: /fng/?limit=... maps one-to-one onto alternative.me
    location /fng/ {
        set $fng_upstream "https://api.alternative.me";
        proxy_pass $fng_upstream$request_uri;
        proxy_ssl_server_name on;
        proxy_ssl_name api.alternative.me;
        proxy_set_header Host api.alternative.me;
        proxy_set_header Accept-Encoding "";
        proxy_read_timeout 20s;
        proxy_cache feeds;
        proxy_cache_key "$uri$is_args$args";
        proxy_cache_valid 200 300s;
        proxy_cache_use_stale error timeout updating http_429 http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_ignore_headers Cache-Control Expires Vary;
        add_header X-Cache-Status $upstream_cache_status;
    }

    # CoinGecko: vite rewrote /cg -> /api/v3, keep the same shape here.
    # The keyless tier allows only a handful of calls per minute per IP and
    # rejects requests without a descriptive User-Agent, so: identify ourselves,
    # keep market history for 30 minutes (it only moves hourly), serve stale when
    # a refresh fails, and answer with an empty list instead of a red 403/429
    # (the screens carry their own static figures for an empty feed).
    location /cg/ {
        set $cg_upstream "https://api.coingecko.com";
        rewrite ^/cg(.*)$ /api/v3$1 break;
        proxy_pass $cg_upstream;
        proxy_ssl_server_name on;
        proxy_ssl_name api.coingecko.com;
        proxy_set_header Host api.coingecko.com;
        proxy_set_header Accept-Encoding "";
        # a product UA with a contact URL is what CoinGecko asks for
        proxy_set_header User-Agent "PasarCrypto/1.0 (+https://pasarcryptoid.com)";
        # a free demo key raises the quota; the header is omitted while empty
        proxy_set_header x-cg-demo-api-key $cg_api_key;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 20s;
        proxy_cache feeds;
        # the default key contains the upstream host, which differs between a
        # direct hit and the CDN's origin fetch: pin it to the request so both
        # share one entry instead of querying CoinGecko twice
        proxy_cache_key "$uri$is_args$args";
        # the ticker is a live quote strip and CoinGecko refreshes its own feed
        # every minute; a short cache keeps the price real without spending the
        # rate limit on every visitor
        proxy_cache_valid 200 60s;
        proxy_cache_valid 404 10s;
        proxy_cache_use_stale error timeout updating http_403 http_429 http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 10s;
        proxy_cache_background_update on;
        proxy_ignore_headers Cache-Control Expires Set-Cookie Vary;
        proxy_hide_header Set-Cookie;
        proxy_intercept_errors on;
        add_header X-Cache-Status $upstream_cache_status;
        error_page 403 429 500 502 503 504 =200 /__cg_fallback.json;
    }

    # reached only through error_page above; `internal` keeps it unreachable
    # from the outside, and no-store means a recovered feed replaces it at once
    location = /__cg_fallback.json {
        internal;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store, must-revalidate" always;
        add_header X-Cg-Fallback "1" always;
        default_type application/json;
        return 200 "[]\n";
    }

    # wilayah.id: vite rewrote /wilayah -> /api, keep the same shape here
    location /wilayah/ {
        set $wilayah_upstream "https://wilayah.id";
        rewrite ^/wilayah(.*)$ /api$1 break;
        proxy_pass $wilayah_upstream;
        proxy_ssl_server_name on;
        proxy_ssl_name wilayah.id;
        proxy_set_header Host wilayah.id;
        proxy_set_header Accept-Encoding "";
        proxy_read_timeout 20s;
        proxy_cache feeds;
        proxy_cache_key "$uri$is_args$args";
        proxy_cache_valid 200 1h;
        proxy_cache_use_stale error timeout updating http_429 http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_ignore_headers Cache-Control Expires Vary;
        add_header X-Cache-Status $upstream_cache_status;
    }

    # ---- SPA routes -------------------------------------------------------
    # BrowserRouter paths such as /pasar/detail have no file behind them:
    # real files win, then known screens get the shell, everything else 404s
    location / {
        try_files $uri $uri/ @spa;
    }

    location @spa {
        if ($app_route = 0) {
            return 404;
        }
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store, must-revalidate";
        rewrite ^ /index.html break;
    }
}
